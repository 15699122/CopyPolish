# Local-only credentials template.
# Copy to secrets/tokens.env, encrypt it with SOPS, and keep the local file out of Git.
# Replace placeholders locally; never commit actual values.
export GITLAB_DEPLOY_TOKEN=<LOCAL_SECRET>
export GITLAB_PAT=<LOCAL_SECRET>
export GITLAB_PROJECT_TOKEN=<LOCAL_SECRET>
export GITLAB_DEPLOY_USER=<LOCAL_USERNAME>